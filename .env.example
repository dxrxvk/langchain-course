# Copy to .env and fill in. .env is gitignored; this file is the checked-in record
# of which keys the projects expect.
# Local Ollama model name, e.g. qwen3:1.7b / qwen3:8b / gpt-oss:20b
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_API_KEY=

# LangSmith tracing — see https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-course
